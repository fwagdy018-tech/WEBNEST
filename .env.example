# ---------- Required: business discovery ----------
# Google Cloud API key with "Places API (New)" enabled. Server-side only.
GOOGLE_PLACES_API_KEY=

# ---------- Recommended: website audits ----------
# Google Cloud API key with "PageSpeed Insights API" enabled (can be the same key).
PAGESPEED_API_KEY=

# ---------- Google Sheets export (service account) ----------
# 1. Create a service account in Google Cloud, enable "Google Sheets API".
# 2. Create a JSON key, copy client_email and private_key below.
# 3. Share your spreadsheet with the client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes; "\n" sequences are converted to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Tab name inside the spreadsheet (created automatically if missing).
GOOGLE_SHEET_TAB=Leads

# ---------- Supabase (search state, resumability, export lock) ----------
# Run supabase/schema.sql once in the Supabase SQL editor.
SUPABASE_URL=
# Service role key: server-side only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Optional ----------
# If set, the whole app asks for this password (HTTP Basic Auth, any username).
# Strongly recommended if you deploy WebNest to a public URL.
WEBNEST_PASSWORD=

# Safety cap on billed Google Places requests per search (whole-state searches
# split busy areas into many map tiles). Default 5000.
MAX_PLACES_REQUESTS_PER_SEARCH=5000
